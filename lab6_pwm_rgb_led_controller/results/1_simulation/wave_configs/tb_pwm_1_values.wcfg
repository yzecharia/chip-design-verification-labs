<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_pwm_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_pwm" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="3856000 ps"></ZoomEndTime>
      <Cursor1Time time="683000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="645000" />
      <marker label="2" time="1925000" />
      <marker label="3" time="3205000" />
   </wave_markers>
   <WVObjectSize size="6" />
   <wvobject type="logic" fp_name="/tb_pwm/reset_n">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
      <obj_property name="label">reset_n</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_pwm/value">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">value[5:0]</obj_property>
      <obj_property name="ObjectShortName">value[5:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">value[5:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_pwm/dut/cnt">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">cnt[5:0]</obj_property>
      <obj_property name="ObjectShortName">cnt[5:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">pwm.cnt[5:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_pwm/dut/cnt_wrap">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">cnt_wrap</obj_property>
      <obj_property name="ObjectShortName">cnt_wrap</obj_property>
      <obj_property name="label">pwm.cnt_wrap</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_pwm/dut/value_reg">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">value_reg[5:0]</obj_property>
      <obj_property name="ObjectShortName">value_reg[5:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">pwm.value_reg[5:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_pwm/pwm_signal">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">pwm_signal</obj_property>
      <obj_property name="ObjectShortName">pwm_signal</obj_property>
      <obj_property name="label">pwm_signal</obj_property>
   </wvobject>
</wave_config>
