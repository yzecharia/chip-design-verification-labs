<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_parser_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab6_pkg" />
            <top_module name="tb_parser" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="213000 ps"></ZoomEndTime>
      <Cursor1Time time="12000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="330"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="10000" />
      <marker label="2" time="30000" />
      <marker label="3" time="50000" />
      <marker label="4" time="70000" />
      <marker label="5" time="90000" />
      <marker label="6" time="110000" />
      <marker label="7" time="130000" />
      <marker label="8" time="150000" />
   </wave_markers>
   <WVObjectSize size="9" />
