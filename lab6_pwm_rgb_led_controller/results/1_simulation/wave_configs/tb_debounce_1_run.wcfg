<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_debounce_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab6_pkg" />
            <top_module name="tb_debounce" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="735000 ps"></ZoomEndTime>
      <Cursor1Time time="144000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="10000" />
      <marker label="2" time="135000" />
      <marker label="3" time="265000" />
      <marker label="4" time="280000" />
      <marker label="5" time="383000" />
      <marker label="6" time="505000" />
      <marker label="7" time="588000" />
      <marker label="8" time="725000" />
   </wave_markers>
   <WVObjectSize size="6" />
   <wvobject type="logic" fp_name="/tb_debounce/reset_n">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
      <obj_property name="label">reset_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_debounce/io_in">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">io_in</obj_property>
      <obj_property name="ObjectShortName">io_in</obj_property>
      <obj_property name="label">io_in</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_debounce/debounce_i/io_sync">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">io_sync</obj_property>
      <obj_property name="ObjectShortName">io_sync</obj_property>
      <obj_property name="label">debounce.io_sync</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_debounce/debounce_i/state">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">state[1:0]</obj_property>
      <obj_property name="ObjectShortName">state[1:0]</obj_property>
      <obj_property name="label">debounce.state[1:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_debounce/debounce_i/cnt">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">cnt[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt[3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">debounce.cnt[3:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_debounce/io_d">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">io_d</obj_property>
      <obj_property name="ObjectShortName">io_d</obj_property>
      <obj_property name="label">io_d</obj_property>
   </wvobject>
</wave_config>
