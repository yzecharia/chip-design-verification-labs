      <obj_property name="ObjectShortName">rx_tx_mode</obj_property>
      <obj_property name="label">rx_tx_mode</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/held">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">held</obj_property>
      <obj_property name="ObjectShortName">held</obj_property>
      <obj_property name="label">held</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/ready">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">ready</obj_property>
      <obj_property name="ObjectShortName">ready</obj_property>
      <obj_property name="label">ready</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/latch_i/latch_en">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">latch_en</obj_property>
      <obj_property name="ObjectShortName">latch_en</obj_property>
      <obj_property name="label">latch.latch_en</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/sw_d">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">sw_d</obj_property>
      <obj_property name="ObjectShortName">sw_d</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
      <obj_property name="label">sw_d[11:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/sw_cfg">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">sw_cfg</obj_property>
      <obj_property name="ObjectShortName">sw_cfg</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
      <obj_property name="label">sw_cfg[11:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/transmit">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">transmit</obj_property>
      <obj_property name="ObjectShortName">transmit</obj_property>
      <obj_property name="label">transmit</obj_property>
