<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_latch_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab5_pkg" />
            <top_module name="tb_latch" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="118000 ps"></ZoomEndTime>
      <Cursor1Time time="47000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="300"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="20000" />
      <marker label="2" time="40000" />
      <marker label="3" time="45000" />
      <marker label="4" time="80000" />
   </wave_markers>
   <WVObjectSize size="8" />
   <wvobject type="logic" fp_name="/tb_latch/reset_n">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
      <obj_property name="label">reset_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/rx_tx_mode">
      <obj_property name="DisplayName">label</obj_property>
