<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_rx_phy_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab5_pkg" />
            <top_module name="tb_rx_phy" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="3205000 ps"></ZoomStartTime>
      <ZoomEndTime time="5075000 ps"></ZoomEndTime>
      <Cursor1Time time="4046000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="3265000" />
      <marker label="2" time="4040000" />
      <marker label="3" time="4875000" />
   </wave_markers>
   <WVObjectSize size="10" />
   <wvobject type="logic" fp_name="/tb_rx_phy/en">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">en</obj_property>
      <obj_property name="ObjectShortName">en</obj_property>
      <obj_property name="label">en</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_rx_phy/rx">
