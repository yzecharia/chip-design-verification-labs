<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_parser_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab5_pkg" />
            <top_module name="tb_parser" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="185000 ps"></ZoomEndTime>
      <Cursor1Time time="17000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="10000" />
      <marker label="2" time="30000" />
      <marker label="3" time="50000" />
      <marker label="4" time="70000" />
      <marker label="5" time="90000" />
      <marker label="6" time="110000" />
      <marker label="7" time="130000" />
      <marker label="8" time="150000" />
      <marker label="9" time="170000" />
   </wave_markers>
   <WVObjectSize size="8" />
   <wvobject type="logic" fp_name="/tb_parser/pkt_valid">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">pkt_valid</obj_property>
      <obj_property name="ObjectShortName">pkt_valid</obj_property>
      <obj_property name="label">pkt_valid</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_parser/dut/valid_opcode">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">valid_opcode</obj_property>
      <obj_property name="ObjectShortName">valid_opcode</obj_property>
      <obj_property name="label">parser.valid_opcode</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_parser/dut/valid_comma">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">valid_comma</obj_property>
      <obj_property name="ObjectShortName">valid_comma</obj_property>
      <obj_property name="label">parser.valid_comma</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_parser/dut/row">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">row[9:0]</obj_property>
      <obj_property name="ObjectShortName">row[9:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">parser.row[9:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_parser/dut/col">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">col[9:0]</obj_property>
      <obj_property name="ObjectShortName">col[9:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">parser.col[9:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_parser/dut/val">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">val[9:0]</obj_property>
      <obj_property name="ObjectShortName">val[9:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">parser.val[9:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_parser/dut/bad_index">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">bad_index</obj_property>
      <obj_property name="ObjectShortName">bad_index</obj_property>
      <obj_property name="label">parser.bad_index</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_parser/msg_valid">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">msg_valid</obj_property>
      <obj_property name="ObjectShortName">msg_valid</obj_property>
      <obj_property name="label">msg_valid</obj_property>
   </wvobject>
</wave_config>
