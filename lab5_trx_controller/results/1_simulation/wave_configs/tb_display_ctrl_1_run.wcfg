<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_display_ctrl_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="lab5_pkg" />
            <top_module name="tb_display_ctrl" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="904000 ps"></ZoomEndTime>
      <Cursor1Time time="307000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="170"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="5000" />
      <marker label="2" time="105000" />
      <marker label="3" time="205000" />
      <marker label="4" time="305000" />
      <marker label="5" time="405000" />
      <marker label="6" time="505000" />
      <marker label="7" time="605000" />
      <marker label="8" time="705000" />
      <marker label="9" time="805000" />
   </wave_markers>
   <WVObjectSize size="6" />
   <wvobject type="logic" fp_name="/tb_display_ctrl/reset_n">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
      <obj_property name="label">reset_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_display_ctrl/dut/tick">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">tick</obj_property>
      <obj_property name="ObjectShortName">tick</obj_property>
      <obj_property name="label">display_ctrl.tick</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_display_ctrl/dut/an">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">an[7:0]</obj_property>
      <obj_property name="ObjectShortName">an[7:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
      <obj_property name="label">display_ctrl.an[7:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_display_ctrl/rx_tx_mode">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">rx_tx_mode</obj_property>
      <obj_property name="ObjectShortName">rx_tx_mode</obj_property>
      <obj_property name="label">rx_tx_mode</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_display_ctrl/dut/data_mode">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">data_mode</obj_property>
      <obj_property name="ObjectShortName">data_mode</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
      <obj_property name="label">display_ctrl.data_mode[5:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_display_ctrl/dut/display_data">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">display_data</obj_property>
      <obj_property name="ObjectShortName">display_data</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
      <obj_property name="label">display_ctrl.display_data[7:0]</obj_property>
   </wvobject>
</wave_config>
