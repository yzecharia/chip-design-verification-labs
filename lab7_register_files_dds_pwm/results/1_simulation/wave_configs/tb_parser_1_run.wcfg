      <obj_property name="ObjectShortName">.data[5:0][7:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
      <obj_property name="label">msg.msg_data.data</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_parser/dut/valid_rgb_cmd">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">valid_rgb_cmd</obj_property>
