      <obj_property name="ElementShortName">.addr[2:0][7:0]</obj_property>
      <obj_property name="ObjectShortName">.addr[2:0][7:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
      <obj_property name="label">msg.msg_data.addr</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_parser/msg.msg_data.data">
      <obj_property name="DisplayName">label</obj_property>
