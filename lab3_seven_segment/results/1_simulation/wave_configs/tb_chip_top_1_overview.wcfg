   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1 SW=12345, BTNC" time="296000" />
