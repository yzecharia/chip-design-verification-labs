      <marker label="6 FFFF hex" time="3135000" />
      <marker label="7 0 dec" time="3715000" />
      <marker label="8 both: hex" time="4295000" />
      <marker label="9 4321 dec" time="4875000" />
      <marker label="10 reset" time="5346000" />
      <marker label="11 189/189 PASS" time="11446000" />
   </wave_markers>
