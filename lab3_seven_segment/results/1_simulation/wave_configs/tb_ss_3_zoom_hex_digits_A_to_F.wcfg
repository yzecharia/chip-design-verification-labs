<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_ss_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_ss" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="90000 ps"></ZoomStartTime>
      <ZoomEndTime time="160000 ps"></ZoomEndTime>
      <Cursor1Time time="90000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="A" time="100000" />
      <marker label="b" time="110000" />
      <marker label="C" time="120000" />
      <marker label="d" time="130000" />
      <marker label="E" time="140000" />
      <marker label="F" time="150000" />
   </wave_markers>
   <WVObjectSize size="5" />
   <wvobject type="array" fp_name="/tb_ss/dig_in">
      <obj_property name="ElementShortName">dig_in[3:0]</obj_property>
      <obj_property name="ObjectShortName">dig_in[3:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ss/ss_dig">
      <obj_property name="ElementShortName">ss_dig[6:0]</obj_property>
      <obj_property name="ObjectShortName">ss_dig[6:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ss/expected_dig_in">
      <obj_property name="ElementShortName">expected_dig_in[4:0]</obj_property>
      <obj_property name="ObjectShortName">expected_dig_in[4:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ss/pass">
      <obj_property name="ElementShortName">pass[4:0]</obj_property>
      <obj_property name="ObjectShortName">pass[4:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_ss/fail">
      <obj_property name="ElementShortName">fail[4:0]</obj_property>
      <obj_property name="ObjectShortName">fail[4:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
</wave_config>
