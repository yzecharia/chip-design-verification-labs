<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_tick_gen_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_tick_gen" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="170000 ps"></ZoomEndTime>
      <Cursor1Time time="0 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1 reset: counter=0" time="10000" />
      <marker label="2 counting" time="20000" />
      <marker label="3 counter=4: tick" time="55000" />
      <marker label="4 wraps to 0" time="65000" />
      <marker label="5 next tick" time="105000" />
      <marker label="6 tick" time="155000" />
   </wave_markers>
   <WVObjectSize size="7" />
   <wvobject type="logic" fp_name="/tb_tick_gen/clk">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_tick_gen/reset_n">
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_tick_gen/tick_gen_i/counter">
      <obj_property name="ElementShortName">counter[2:0]</obj_property>
      <obj_property name="ObjectShortName">counter[2:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_tick_gen/tick">
      <obj_property name="ElementShortName">tick</obj_property>
      <obj_property name="ObjectShortName">tick</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_tick_gen/cycles">
      <obj_property name="ElementShortName">cycles[31:0]</obj_property>
      <obj_property name="ObjectShortName">cycles[31:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_tick_gen/pass">
      <obj_property name="ElementShortName">pass[31:0]</obj_property>
      <obj_property name="ObjectShortName">pass[31:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_tick_gen/fail">
      <obj_property name="ElementShortName">fail[31:0]</obj_property>
      <obj_property name="ObjectShortName">fail[31:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
</wave_config>
