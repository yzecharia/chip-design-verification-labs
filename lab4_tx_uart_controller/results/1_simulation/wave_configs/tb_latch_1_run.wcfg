<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_latch_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_latch" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="165000 ps"></ZoomEndTime>
      <Cursor1Time time="77000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="35000" />
      <marker label="2" time="50000" />
      <marker label="3" time="75000" />
      <marker label="4" time="110000" />
      <marker label="5" time="125000" />
   </wave_markers>
   <WVObjectSize size="9" />
   <wvobject type="logic" fp_name="/tb_latch/reset_n">
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/held">
      <obj_property name="ElementShortName">held</obj_property>
      <obj_property name="ObjectShortName">held</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/ready">
      <obj_property name="ElementShortName">ready</obj_property>
      <obj_property name="ObjectShortName">ready</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/latch_i/load_cfg">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">load_cfg</obj_property>
      <obj_property name="ObjectShortName">load_cfg</obj_property>
      <obj_property name="label">latch.load_cfg</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/sw_d">
      <obj_property name="ElementShortName">sw_d[11:0]</obj_property>
      <obj_property name="ObjectShortName">sw_d[11:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/data">
      <obj_property name="ElementShortName">data[7:0]</obj_property>
      <obj_property name="ObjectShortName">data[7:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/delay">
      <obj_property name="ElementShortName">delay[1:0]</obj_property>
      <obj_property name="ObjectShortName">delay[1:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_latch/size">
      <obj_property name="ElementShortName">size[1:0]</obj_property>
      <obj_property name="ObjectShortName">size[1:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_latch/transmit">
      <obj_property name="ElementShortName">transmit</obj_property>
      <obj_property name="ObjectShortName">transmit</obj_property>
   </wvobject>
</wave_config>
