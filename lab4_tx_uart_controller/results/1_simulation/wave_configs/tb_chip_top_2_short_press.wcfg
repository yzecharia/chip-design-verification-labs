<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_chip_top_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_chip_top" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="3310000 ps"></ZoomStartTime>
      <ZoomEndTime time="3515000 ps"></ZoomEndTime>
      <Cursor1Time time="3310000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1 btnc=1" time="3330000" />
      <marker label="2 btnc=0" time="3380000" />
      <marker label="3 btnc_d=1" time="3395000" />
      <marker label="4 btnc_d=0" time="3445000" />
      <marker label="5 IDLE: no held" time="3455000" />
   </wave_markers>
   <WVObjectSize size="7" />
   <wvobject type="logic" fp_name="/tb_chip_top/btnc">
      <obj_property name="ElementShortName">btnc</obj_property>
      <obj_property name="ObjectShortName">btnc</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_chip_top/dut/btnc_d">
      <obj_property name="ElementShortName">btnc_d</obj_property>
      <obj_property name="ObjectShortName">btnc_d</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_chip_top/dut/btn_hold_i/state">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">state[1:0]</obj_property>
      <obj_property name="ObjectShortName">state[1:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">btn_hold.state[1:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_chip_top/dut/btn_hold_i/cnt">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">cnt[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt[3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">btn_hold.cnt[3:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_chip_top/dut/held">
      <obj_property name="ElementShortName">held</obj_property>
      <obj_property name="ObjectShortName">held</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_chip_top/dut/transmit">
      <obj_property name="ElementShortName">transmit</obj_property>
      <obj_property name="ObjectShortName">transmit</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_chip_top/tx">
      <obj_property name="ElementShortName">tx</obj_property>
      <obj_property name="ObjectShortName">tx</obj_property>
   </wvobject>
</wave_config>
