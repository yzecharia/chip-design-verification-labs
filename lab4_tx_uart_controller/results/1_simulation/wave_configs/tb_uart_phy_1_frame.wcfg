<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_uart_phy_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_uart_phy" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="1020000 ps"></ZoomStartTime>
      <ZoomEndTime time="2075000 ps"></ZoomEndTime>
      <Cursor1Time time="1020000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1 start bit=0 (data=AA)" time="1045000" />
      <marker label="2 D0=0" time="1145000" />
      <marker label="3 D1=1" time="1245000" />
      <marker label="4 D2=0" time="1345000" />
      <marker label="5 D3=1" time="1445000" />
      <marker label="6 D4=0" time="1545000" />
      <marker label="7 D5=1" time="1645000" />
      <marker label="8 D6=0" time="1745000" />
      <marker label="9 D7=1" time="1845000" />
      <marker label="10 stop=1" time="1945000" />
      <marker label="11 done" time="2035000" />
   </wave_markers>
   <WVObjectSize size="8" />
   <wvobject type="logic" fp_name="/tb_uart_phy/start">
      <obj_property name="ElementShortName">start</obj_property>
      <obj_property name="ObjectShortName">start</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_uart_phy/data">
      <obj_property name="ElementShortName">data[7:0]</obj_property>
      <obj_property name="ObjectShortName">data[7:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_uart_phy/uart_phy_i/state">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">state</obj_property>
      <obj_property name="ObjectShortName">state</obj_property>
      <obj_property name="label">uart_phy.state</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_uart_phy/uart_phy_i/tick">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">tick</obj_property>
      <obj_property name="ObjectShortName">tick</obj_property>
      <obj_property name="label">uart_phy.tick</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_uart_phy/uart_phy_i/cnt">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">cnt[3:0]</obj_property>
      <obj_property name="ObjectShortName">cnt[3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">uart_phy.cnt[3:0]</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_uart_phy/uart_phy_i/sh_reg">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">sh_reg[9:0]</obj_property>
      <obj_property name="ObjectShortName">sh_reg[9:0]</obj_property>
      <obj_property name="Radix">BINARYRADIX</obj_property>
      <obj_property name="label">uart_phy.sh_reg[9:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_uart_phy/tx">
      <obj_property name="ElementShortName">tx</obj_property>
      <obj_property name="ObjectShortName">tx</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_uart_phy/done">
      <obj_property name="ElementShortName">done</obj_property>
      <obj_property name="ObjectShortName">done</obj_property>
   </wvobject>
</wave_config>
