<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_baud_gen_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_baud_gen" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0 ps"></ZoomStartTime>
      <ZoomEndTime time="315000 ps"></ZoomEndTime>
      <Cursor1Time time="110000 ps"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="235"></NameColumnWidth>
      <ValueColumnWidth column_width="120"></ValueColumnWidth>
   </column_width_setting>
   <wave_markers>
      <marker label="1" time="20000" />
      <marker label="2" time="105000" />
      <marker label="3" time="205000" />
      <marker label="4" time="220000" />
   </wave_markers>
   <WVObjectSize size="4" />
   <wvobject type="logic" fp_name="/tb_baud_gen/reset_n">
      <obj_property name="ElementShortName">reset_n</obj_property>
      <obj_property name="ObjectShortName">reset_n</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_baud_gen/en">
      <obj_property name="ElementShortName">en</obj_property>
      <obj_property name="ObjectShortName">en</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/tb_baud_gen/baud_gen_i/tick_cnt">
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="ElementShortName">tick_cnt[3:0]</obj_property>
      <obj_property name="ObjectShortName">tick_cnt[3:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="label">baud_gen.tick_cnt[3:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/tb_baud_gen/baud_tick">
      <obj_property name="ElementShortName">baud_tick</obj_property>
      <obj_property name="ObjectShortName">baud_tick</obj_property>
   </wvobject>
</wave_config>
